{
  "name": "candyblossomelectron",
  "version": "1.0.0",
  "description": "Windows Application for Candy Blossom",
  "homepage": "https://github.com/happyunicorngirlcute/Candy-Blossom-Electron#readme",
  "bugs": {
    "url": "https://github.com/happyunicorngirlcute/Candy-Blossom-Electron/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyunicorngirlcute/Candy-Blossom-Electron.git"
  },
  "license": "ISC",
  "author": "Happyunicorngirlcute",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix candyblossomnextjs run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:clean": "npm --prefix candyblossomnextjs run clean && npm run dev",
    "build": "npm --prefix candyblossomnextjs run build",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "wait-on": "^9.0.10"
  }
}
